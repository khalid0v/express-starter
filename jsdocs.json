{
  "source": {
    "include": ["src"],
    "exclude": ["node_modules", "dist", "coverage", "docs"],
    "excludePattern": "(node_modules|dist|coverage|docs)"
  },
  "opts": {
    "destination": "./docs",
    "recurse": true,
    "readme": "./README.md"
  },
  "plugins": ["plugins/markdown"],
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": false
  },
  "recurseDepth": 10
}
