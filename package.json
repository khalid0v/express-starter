{
	"name": "exprss",
	"version": "1.0.0",
	"description": "",
	"homepage": "https://github.com/khalid0v/express-starter#readme",
	"bugs": {
		"url": "https://github.com/khalid0v/express-starter/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/khalid0v/express-starter.git"
	},
	"type": "commonjs",
	"main": "dist/apps/server.js",
	"scripts": {
		"dev": "tsx watch apps/server.ts",
		"s3:test": "tsx scripts/s3-test.ts",
		"terraform": "terraform",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write --unsafe .",
		"ci": "biome ci .",
		"prisma:generate": "prisma generate && prisma generate --schema prisma/sqlite.schema.prisma",
		"prisma:migrate": "prisma migrate dev",
		"prisma:deploy": "prisma migrate deploy",
		"prisma:studio": "prisma studio",
		"prisma:push": "prisma db push",
		"prisma:generate:sqlite": "prisma generate --schema prisma/sqlite.schema.prisma",
		"prisma:push:sqlite": "prisma db push --schema prisma/sqlite.schema.prisma",
		"start": "node dist/apps/server.js",
		"build": "tsc -p tsconfig.json",
		"postinstall": "prisma generate && prisma generate --schema prisma/sqlite.schema.prisma"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1147.0",
		"@aws-sdk/s3-request-presigner": "^3.1147.0",
		"@neondatabase/serverless": "^1.2.0",
		"@prisma/adapter-better-sqlite3": "^7.10.1",
		"@prisma/adapter-neon": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"better-auth": "^1.7.7",
		"better-sqlite3": "^13.0.3",
		"compression": "^1.8.2",
		"dotenv": "^18.0.6",
		"express": "^5.2.1",
		"morgan": "^1.12.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/compression": "^1.8.1",
		"@types/errorhandler": "^1.5.3",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.6.6",
		"prisma": "^7.10.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
